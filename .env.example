# ── MySQL (docker-compose) ───────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=127.0.0.1
# 호스트 3306은 Docker 바인딩 충돌로 3307 사용 (컨테이너 내부는 3306)
MYSQL_PORT=3307
MYSQL_DATABASE=weave
MYSQL_USER=weave
MYSQL_PASSWORD=change-me

# ── Kakao OAuth ──────────────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8081/api/auth/kakao/callback

# ── Backend ──────────────────────────────────────────────
# 로컬 8080은 searxng 컨테이너가 점유 — 기본 8081 사용
SERVER_PORT=8081

# ── JWT ──────────────────────────────────────────────────
# 생성 방법: openssl rand -base64 64  (HS256 최소 256bit 이상 권장)
JWT_SECRET=

# ── Demo login ───────────────────────────────────────────
# true면 POST /api/auth/demo 활성 (로컬·데모 전용, 프로덕션 false)
DEMO_ENABLED=true
