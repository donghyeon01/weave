# ── MySQL (docker-compose) ───────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=127.0.0.1
# 호스트 3306은 Docker 바인딩 충돌로 3307 사용 (컨테이너 내부는 3306)
MYSQL_PORT=3307
MYSQL_DATABASE=weave
MYSQL_USER=weave
MYSQL_PASSWORD=change-me

# ── Kakao OAuth ──────────────────────────────────────────
# 카카오 개발자 콘솔 → 내 애플리케이션 → 앱 키 → REST API 키 / Client Secret
# Redirect URI는 fe 라우트(5173/login/kakao/callback) — fe/.env의 VITE_KAKAO_*로 관리
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── Google OAuth ─────────────────────────────────────────
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID
# Redirect URI는 fe 라우트(5173/login/google/callback) — fe/.env의 VITE_GOOGLE_*로 관리
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Backend ──────────────────────────────────────────────
# 로컬 8080은 searxng 컨테이너가 점유 — 기본 8081 사용
SERVER_PORT=8081
# 일기 사진 로컬 스토리지 루트 — 기본 ./uploads (be 작업 디렉터리 기준)
UPLOAD_DIR=./uploads

# ── JWT ──────────────────────────────────────────────────
# 생성 방법: openssl rand -base64 64  (HS256 최소 256bit 이상 권장)
JWT_SECRET=

# ── Demo login ───────────────────────────────────────────
# true면 POST /api/auth/demo 활성 (로컬·데모 전용, 프로덕션 false)
DEMO_ENABLED=true

# ── 배포 (docker-compose.prod.yml / Vercel) ────────────
# COOKIE_SAMESITE=None — fe와 API가 cross-site일 때 refresh 쿠키 전송에 필수
COOKIE_SAMESITE=
# OCI 공인 IP 기반 nip.io 도메인 — 박스 기존 nginx+certbot이 HTTPS 처리. 예: 1-2-3-4.nip.io
API_DOMAIN=
# fe 오리진 — prod는 vercel.app 도메인. 예: https://weave.vercel.app
CORS_ALLOWED_ORIGINS=
