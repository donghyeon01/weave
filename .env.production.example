# docker-compose.prod.yml용 — `cp .env.production.example .env.production` 후 채우기
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# openssl rand -base64 64
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# OCI 공인 IP 기반 nip.io 도메인 — Caddy가 자동 HTTPS 발급. 예: 1-2-3-4.nip.io
API_DOMAIN=
# fe 오리진 — Vercel 도메인. 예: https://weave.vercel.app
CORS_ALLOWED_ORIGINS=
