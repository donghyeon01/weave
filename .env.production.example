# docker-compose.prod.yml용 — `cp .env.production.example .env.production` 후 채우기
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# openssl rand -base64 64
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Google Cloud Console → OAuth 2.0 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OCI 공인 IP 기반 nip.io 도메인 — Caddy가 자동 HTTPS 발급. 예: 1-2-3-4.nip.io
API_DOMAIN=
# fe 오리진 — Vercel 도메인. 예: https://weave.vercel.app
CORS_ALLOWED_ORIGINS=
# 일기 사진 호스트 저장 경로 — be 컨테이너의 /data/uploads에 바인드 마운트 (기본 ~/weave-ops/uploads)
HOST_UPLOAD_DIR=
# true면 POST /api/auth/demo 활성 (방문자 둘러보기용, IP당 10회/시간 제한)
DEMO_ENABLED=true
