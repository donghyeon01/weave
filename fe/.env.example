# ── Google OAuth (fe) ────────────────────────────────────
# Vite는 VITE_ 접두사 변수만 클라이언트 번들에 노출한다.
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID
VITE_GOOGLE_CLIENT_ID=
# 인가 코드를 수신하는 fe 라우트 — Google 콘솔 "승인된 리디렉션 URI" 등록값과 일치 필수.
# 콜백에서 code를 POST /api/auth/oauth/google {code, redirectUri}로 교환한다.
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/login/google/callback
