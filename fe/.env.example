# ── API base (fe) ────────────────────────────────────────
# 비우면 same-origin 상대 경로 — 로컬 dev/preview는 vite 프록시로 해결.
# 배포(fe와 be가 다른 origin)는 반드시 설정. 예: https://1-2-3-4.nip.io
VITE_API_BASE_URL=

# ── Kakao OAuth (fe) ─────────────────────────────────────
# Vite는 VITE_ 접두사 변수만 클라이언트 번들에 노출한다.
# 카카오 개발자 콘솔 → 내 애플리케이션 → 앱 키 → REST API 키
VITE_KAKAO_CLIENT_ID=
# 인가 코드를 수신하는 fe 라우트 — 카카오 앱 "Redirect URI" 등록값과 일치 필수.
# 콜백에서 code를 POST /api/auth/oauth/kakao {code, redirectUri}로 교환한다.
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/login/kakao/callback
